<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3EEE6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="30dp">

        <!-- Back Button -->

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="← Back"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5A4638"
            android:elevation="2dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="28dp"/>


        <!-- Page Title -->

        <TextView
            android:id="@+id/txtDetailsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="College Details"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2F2924"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>


        <!-- College Name -->

        <TextView
            android:id="@+id/txtDetailsName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="College Name"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#5A4638"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="28dp"/>


        <!-- Rank -->

        <TextView
            android:id="@+id/txtDetailsRank"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NIRF Rank: #1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#5A4638"
            android:gravity="center"
            android:padding="18dp"
            android:background="#E5D8C8"
            android:elevation="1dp"
            android:layout_marginBottom="14dp"/>


        <!-- NIRF Score -->

        <TextView
            android:id="@+id/txtDetailsScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NIRF Score: 88.72"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:padding="18dp"
            android:background="#5A4638"
            android:elevation="2dp"
            android:layout_marginBottom="26dp"/>


        <!-- City -->

        <TextView
            android:id="@+id/txtDetailsCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="City: Chennai"
            android:textSize="17sp"
            android:textColor="#514941"
            android:padding="16dp"
            android:background="#FFFDFC"
            android:elevation="1dp"
            android:layout_marginBottom="12dp"/>


        <!-- State -->

        <TextView
            android:id="@+id/txtDetailsState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="State: Tamil Nadu"
            android:textSize="17sp"
            android:textColor="#514941"
            android:padding="16dp"
            android:background="#FFFDFC"
            android:elevation="1dp"
            android:layout_marginBottom="12dp"/>


        <!-- Institution Type -->

        <TextView
            android:id="@+id/txtDetailsType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Institution Type: IIT"
            android:textSize="17sp"
            android:textColor="#514941"
            android:padding="16dp"
            android:background="#FFFDFC"
            android:elevation="1dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>