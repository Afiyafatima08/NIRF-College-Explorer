<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3EEE6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="30dp">

        <!-- Back Button -->

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="← Back"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5A4638"
            android:elevation="2dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="26dp"/>


        <!-- Title -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NIRF Rank Bands"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2F2924"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>


        <!-- Subtitle -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a rank band to explore colleges"
            android:textSize="15sp"
            android:textColor="#806F62"
            android:gravity="center"
            android:layout_marginBottom="34dp"/>


        <!-- Rank 1 - 10 -->

        <Button
            android:id="@+id/btnBand1"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Rank 1 - 10"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5A4638"
            android:elevation="3dp"
            android:layout_marginBottom="18dp"/>


        <!-- Rank 11 - 20 -->

        <Button
            android:id="@+id/btnBand2"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Rank 11 - 20"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6B5545"
            android:elevation="3dp"
            android:layout_marginBottom="18dp"/>


        <!-- Rank 21 - 50 -->

        <Button
            android:id="@+id/btnBand3"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Rank 21 - 50"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7B6656"
            android:elevation="3dp"
            android:layout_marginBottom="18dp"/>


        <!-- Rank 51 - 100 -->

        <Button
            android:id="@+id/btnBand4"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Rank 51 - 100"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#8A7463"
            android:elevation="3dp"
            android:layout_marginBottom="10dp"/>

    </LinearLayout>

</ScrollView>